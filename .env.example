# ==============================================================================
# QuickQR — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real secrets to version control.
# ==============================================================================

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/quickqr?schema=public"

# Cryptographic Application Secret (Used for session token HMAC and cookies)
# Minimum 32 characters (recommended: 64-character hex string)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-a-secure-random-64-character-hex-string"

# Canonical Public App URL (Used for metadata, absolute links, and widget APIs)
# Local development: http://localhost:3000
# Production:        https://quickqr.amanxthink11.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public Dynamic QR Redirect Base URL (/q/{shortCode})
# Local development: http://localhost:3000
# Production:        https://quickqr.amanxthink11.com
NEXT_PUBLIC_QR_BASE_URL="http://localhost:3000"

# Optional: Disable in-memory caching for QR short-code resolver (set to 'true' to bypass)
# DISABLE_QR_RESOLVER_CACHE="false"

# Node Environment ('development', 'production', or 'test')
NODE_ENV="development"
